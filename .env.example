# WattLlama settings. Copy to .env (install.ps1 does that) and edit; every line is optional.

# Where the page is served. 127.0.0.1 = this PC only.
# 0.0.0.0 = also from your phone on the home network (install.ps1 -AllowLan adds the firewall rule).
DASH_HOST=127.0.0.1
DASH_PORT=8091

# llama.cpp server or router. Empty = power tracking only, no LLM tracking.
DASH_LLAMA_URL=http://127.0.0.1:8080
# Optional: the file the llama.cpp server writes its log to (stdout redirected).
# Gives exact token counts. Without it, /metrics is used when the server runs with
# --metrics (also exact), otherwise /slots (approximate).
DASH_LLAMA_LOG=

# Parts of the PC that cannot be measured in software: motherboard, disks, fans, USB.
# 25-50 W is typical for a desktop. Add your GPU's idle and load draw here if it is not NVIDIA.
DASH_REST_W=35
# Power supply efficiency at this load (80 Plus Bronze ~0.85, Gold ~0.88-0.90, Platinum ~0.92).
DASH_PSU_EFF=0.88
# Only used when Windows does not expose CPU power (no "Energy Meter" counters):
# the CPU's max package power, used to estimate from utilisation.
DASH_CPU_MAX_W=65

# Optional: LibreHardwareMonitor web server (Options > Remote Web Server > Run) for CPU core
# temperatures, fans, motherboard and SSD temperatures. Windows has no driver-free way to read them.
DASH_LHM_URL=

# Optional: if your llama.cpp server runs with --api-key.
DASH_LLAMA_API_KEY=

# Optional: allow changing the NVIDIA power limit from the page (off by default).
# Only from this PC, between 60 % of the default and the card's max, confirmed in a UAC
# prompt, reset at reboot. A power limit caps watts; it does not undervolt and cannot crash the PC.
DASH_ALLOW_POWER_LIMIT=0

# Optional: require a token (install.ps1 -AllowLan sets one). Open the page once with ?token=...
DASH_TOKEN=

# Optional: Windows scheduled tasks to list with their schedule, last and next run.
# Comma-separated names or wildcards, e.g. MyBackup,LLM*
DASH_TASKS=

# Optional: pi agent config folder (default %USERPROFILE%\.pi\agent). Shown when it exists.
# DASH_PI_DIR=

# Sampling interval in milliseconds.
DASH_INTERVAL_MS=2000
