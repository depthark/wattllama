# WattLlama settings. Copy to .env (install.ps1 does that) and edit; every line is optional.

# Where the page is served. 127.0.0.1 = this PC only.
# 0.0.0.0 = also from your phone on the home network (install.ps1 -AllowLan adds the firewall rule).
DASH_HOST=127.0.0.1
DASH_PORT=8091

# Inference engines. All are found automatically on their default ports; an engine that
# is not running costs nothing (it is asked again every 10 s). Limit with e.g. DASH_ENGINES=ollama
DASH_ENGINES=auto

# llama.cpp server or router. Empty = off.
DASH_LLAMA_URL=http://127.0.0.1:8080
# Optional: the file the llama.cpp server writes its log to (stdout redirected).
# Gives exact token counts. Without it, /metrics is used when the server runs with
# --metrics (also exact), otherwise /slots (approximate).
DASH_LLAMA_LOG=

# Ollama. Default: OLLAMA_HOST, else http://127.0.0.1:11434. Empty = off.
# DASH_OLLAMA_URL=
# Ollama's log, for exact token counts. Default: %LOCALAPPDATA%\Ollama\server.log (the Ollama app).
# DASH_OLLAMA_LOG=
# Linux: Ollama's systemd service logs to the journal, read when your user may (systemd-journal
# group). 0 = do not read it. The unit name, if yours is not "ollama":
# DASH_OLLAMA_JOURNAL=1
# DASH_OLLAMA_UNIT=ollama

# LM Studio's local server (Developer > Start server). Empty = off.
# Token counts come from its CLI (lms, in %USERPROFILE%\.lmstudio\bin), found automatically.
# DASH_LMSTUDIO_URL=http://127.0.0.1:1234
# DASH_LMSTUDIO_API_KEY=
# DASH_LMSTUDIO_LMS=

# Parts of the PC that cannot be measured in software: motherboard, disks, fans, USB.
# 25-50 W is typical for a desktop. Add your GPU's typical draw here if it is neither NVIDIA
# nor read through LibreHardwareMonitor (AMD / Intel Arc).
DASH_REST_W=35
# Power supply efficiency at this load (80 Plus Bronze ~0.85, Gold ~0.88-0.90, Platinum ~0.92).
DASH_PSU_EFF=0.88
# Only used when Windows does not expose CPU power (no "Energy Meter" counters):
# the CPU's max package power, used to estimate from utilisation.
DASH_CPU_MAX_W=65

# Optional: what electricity costs you, to see money next to kWh (board and report).
# The all-in price per kWh from your bill (energy + distribution + fees + tax), and a currency:
# an ISO code (EUR, USD, CZK, ...) is formatted the way your browser does; any other text is shown as is.
# Leave empty for watts and kWh only.
DASH_PRICE_PER_KWH=
DASH_CURRENCY=

# Alerts: shown on the page (and as browser notifications if you allow them). A condition must
# last a minute (engines: 2 minutes) before it fires; the same alert repeats after the cooldown at
# the earliest. An empty value turns that rule off. DASH_ALERTS=0 turns all of them off.
DASH_ALERTS=1
DASH_ALERT_GPU_TEMP=83
DASH_ALERT_CPU_TEMP=90
# A GPU's memory this full makes models spill into system RAM, which can halve the speed.
DASH_ALERT_VRAM_PCT=99
# One model generating without a pause this long (minutes): a runaway generation or a stuck agent.
DASH_ALERT_BUSY_MIN=60
# Daily budgets, off unless set: kWh, or money (needs DASH_PRICE_PER_KWH).
DASH_ALERT_DAILY_KWH=
DASH_ALERT_DAILY_COST=
DASH_ALERT_COOLDOWN_MIN=30
# 0 turns off: GPU slowing down for heat (not the normal power cap) / an engine that stops answering.
# DASH_ALERT_THROTTLE=1
# DASH_ALERT_ENGINE_DOWN=1

# Optional: also send alerts to your phone. A Discord webhook URL, an ntfy topic URL
# (https://ntfy.sh/<long-random-topic>, then subscribe in the ntfy app), a Slack webhook, or any
# URL that takes JSON. https only (plain http only to this PC or your local network). This is the
# only thing WattLlama ever sends out, and only numbers and model names. The URL is a secret:
# it is never shown on the page or written to the log. Try it: node server.mjs --test-alert
DASH_ALERT_WEBHOOK=
# discord | ntfy | slack | json, if it cannot be told from the URL
# DASH_ALERT_FORMAT=

# Optional: LibreHardwareMonitor web server (Options > Remote Web Server > Run) for CPU core
# temperatures, fans, motherboard and SSD temperatures, and AMD / Intel Arc GPU power.
# Windows has no driver-free way to read them.
DASH_LHM_URL=

# Optional: if your llama.cpp server runs with --api-key.
DASH_LLAMA_API_KEY=

# Optional: allow changing the NVIDIA power limit from the page (off by default).
# Only from this PC, between 60 % of the default and the card's max, confirmed in a UAC
# prompt, reset at reboot. A power limit caps watts; it does not undervolt and cannot crash the PC.
DASH_ALLOW_POWER_LIMIT=0

# Optional: require a token (install.ps1 -AllowLan sets one). Open the page once with ?token=...
DASH_TOKEN=

# Optional: Windows scheduled tasks, or on Linux systemd timers (user and system), to list with
# their schedule, last and next run.
# Comma-separated names or wildcards, e.g. MyBackup,LLM*
DASH_TASKS=

# Optional: pi agent config folder (default %USERPROFILE%\.pi\agent). Shown when it exists.
# DASH_PI_DIR=

# Sampling interval in milliseconds.
DASH_INTERVAL_MS=2000
